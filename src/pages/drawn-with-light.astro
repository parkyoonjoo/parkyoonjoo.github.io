---
import Detail from '../layouts/Detail.astro';
import data from '../../content/photos.json';
import { u, isTodo } from '../lib/url';

// 파일 번호가 큰 사진이 먼저 (왼쪽 위 → 오른쪽 → 아래). 새 사진을 큰 번호로 넣으면 항상 맨 앞에 온다
const num = (src: string) => Number(src.match(/(\d+)\.\w+$/)?.[1] ?? 0);
const sorted = [...data.photos].sort((a, b) => num(b.src) - num(a.src));
const photos = sorted.map((p, i) => ({
  ...p,
  src: u(p.src),
  thumb: u((p as { thumb?: string }).thumb ?? p.src),
  caption: isTodo(p.caption) && p.caption.trim() === '' ? '' : p.caption,
  index: i,
}));
---

<Detail title="Drawn with Light" section="drawn-with-light" description="Film photographs by Yoonjoo Park.">
  <h1 class="page-title">Drawn with Light</h1>

  <!-- 인스타그램 피드처럼 정사각형 썸네일 3열. 누르면 원본 비율로 크게 -->
  <ul class="feed">
    {
      photos.map((p) => (
        <li>
          <button class="feed-item" type="button" data-index={p.index} aria-label={`Open photo ${p.index + 1}`}>
            <img src={p.thumb} alt={p.alt} width={p.width} height={p.height} loading={p.index < 9 ? 'eager' : 'lazy'} decoding="async" />
          </button>
        </li>
      ))
    }
  </ul>

  <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <figure class="lb-figure">
      <img class="lb-img" data-lb-img src={photos[0]?.src} alt={photos[0]?.alt ?? ''} />
      <figcaption class="lb-caption" data-lb-caption></figcaption>
    </figure>
    <button class="lb-btn lb-prev" type="button" data-lb-prev aria-label="Previous photo">←</button>
    <button class="lb-btn lb-next" type="button" data-lb-next aria-label="Next photo">→</button>
    <button class="lb-btn lb-close" type="button" data-lb-close aria-label="Close">esc</button>
    <p class="lb-count muted" data-lb-count aria-live="polite"></p>
  </div>

  <script is:inline type="application/json" id="photo-data" set:html={JSON.stringify(photos)} />
</Detail>

<script>
  type Photo = { src: string; alt: string; caption: string };
  const photos: Photo[] = JSON.parse(document.getElementById('photo-data')?.textContent || '[]');
  const lb = document.querySelector<HTMLElement>('[data-lightbox]')!;
  const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const cap = lb.querySelector<HTMLElement>('[data-lb-caption]')!;
  const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
  const closeBtn = lb.querySelector<HTMLButtonElement>('[data-lb-close]')!;
  let current = 0;
  let opener: HTMLElement | null = null;

  const show = (i: number) => {
    current = (i + photos.length) % photos.length;
    const p = photos[current];
    img.src = p.src;
    img.alt = p.alt;
    cap.textContent = p.caption;
    cap.hidden = !p.caption;
    count.textContent = `${current + 1} / ${photos.length}`;
  };

  const open = (i: number, from: HTMLElement) => {
    opener = from;
    show(i);
    lb.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    closeBtn.focus();
  };

  const close = () => {
    lb.hidden = true;
    document.documentElement.style.overflow = '';
    opener?.focus();
  };

  document.querySelectorAll<HTMLButtonElement>('.feed-item').forEach((b) =>
    b.addEventListener('click', () => open(Number(b.dataset.index), b)),
  );
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
  closeBtn.addEventListener('click', close);
  // 사진 바깥(검은 배경)을 누르면 닫기
  lb.addEventListener('click', (e) => {
    if (e.target === lb) close();
  });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(current - 1);
    else if (e.key === 'ArrowRight') show(current + 1);
    else if (e.key === 'Tab') {
      // 뷰어 안에서만 포커스가 돌게
      const f = [...lb.querySelectorAll<HTMLElement>('button')];
      const i = f.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) {
        e.preventDefault();
        f[f.length - 1].focus();
      } else if (!e.shiftKey && i === f.length - 1) {
        e.preventDefault();
        f[0].focus();
      }
    }
  });
</script>

<style>
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .feed-item {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 0;
    background: #1a1a1a;
    overflow: hidden;
    cursor: zoom-in;
  }

  .feed-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .feed-item:hover img {
      transform: scale(1.025);
    }
  }

  .feed-item:focus-visible {
    outline: 1px solid #fff;
    outline-offset: 2px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.94);
    display: grid;
    place-items: center;
    padding: 64px 88px;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 100%;
    max-height: 100%;
  }

  /* 원본 비율 그대로 */
  .lb-img {
    max-width: 100%;
    max-height: calc(100vh - 180px);
    width: auto;
    height: auto;
    display: block;
  }

  .lb-caption {
    font-size: 13px;
    color: var(--fg-muted);
  }

  .lb-btn {
    position: absolute;
    min-width: 44px;
    min-height: 44px;
    padding: 8px 12px;
    background: transparent;
    border: 0;
    color: #fff;
    font: inherit;
    font-size: 18px;
    cursor: pointer;
  }

  .lb-btn:hover {
    color: var(--fg-muted);
  }

  .lb-prev {
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-next {
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-close {
    top: 16px;
    right: 20px;
    font-size: 13px;
  }

  .lb-count {
    position: absolute;
    top: 28px;
    left: 32px;
    margin: 0;
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .lightbox {
      padding: 64px 12px 96px;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 24px;
      transform: none;
    }
  }
</style>
