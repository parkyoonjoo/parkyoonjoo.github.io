---
import { getCollection } from 'astro:content';
import Detail from '../../layouts/Detail.astro';
import { u } from '../../lib/url';

// 두 갈래. 융합 작업은 두 태그 모두 → 어느 쪽을 눌러도 보인다
const TAGS = ['Engineering', 'Art & Design'] as const;
const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order || String(b.data.year).localeCompare(String(a.data.year)));
---

<Detail title="Work" section="work" description="Work by Yoonjoo Park across engineering, art and design.">
  <h1 class="page-title">Work</h1>

  <!-- 태그로 거르기 (기본은 전체) -->
  <div class="filters" role="group" aria-label="Filter by tag">
    <button class="filter" type="button" data-filter="all" aria-pressed="true">All</button>
    {TAGS.map((t) => <button class="filter" type="button" data-filter={t} aria-pressed="false">{t}</button>)}
  </div>

  <ul class="work-list">
    {
      works.map((w) => (
        <li data-tags={w.data.tags.join('|')}>
          <a class="work-row" href={u(`/work/${w.id}`)}>
            <img class="work-thumb" src={u(w.data.thumbnail)} alt="" width="600" height="600" loading="lazy" decoding="async" />
            <span class="work-text">
              <span class="work-title">{w.data.title}</span>
              <span class="work-summary muted">{w.data.summary}</span>
              <span class="work-meta muted">
                {w.data.year} · {w.data.tags.join(' · ')}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="work-empty muted" data-empty hidden>Nothing in this category yet.</p>
</Detail>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('.work-list li')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      items.forEach((li) => {
        const on = f === 'all' || (li.dataset.tags ?? '').split('|').includes(f);
        li.hidden = !on;
        if (on) shown++;
      });
      empty.hidden = shown > 0;
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .filter {
    min-height: 36px;
    padding: 6px 14px;
    font: inherit;
    font-size: 13px;
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 0;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 120ms var(--ease-out);
  }

  .filter:hover {
    border-color: #fff;
  }

  .filter:active {
    transform: scale(0.97);
  }

  .filter[aria-pressed='true'] {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .work-list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .work-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    align-items: center;
    padding: 20px 0;
    color: #fff;
    text-decoration: none;
  }

  .work-thumb {
    width: 120px;
    height: 120px;
    object-fit: cover;
    display: block;
    transition: transform 300ms var(--ease-out);
  }

  .work-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .work-title {
    font-size: 20px;
    font-weight: 700;
  }

  .work-summary {
    font-size: 14px;
    line-height: 1.5;
  }

  .work-meta {
    font-size: 12px;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-row:hover .work-thumb {
      transform: scale(1.025);
    }
    .work-row:hover .work-title {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  @media (max-width: 640px) {
    .work-row {
      grid-template-columns: 88px 1fr;
      gap: 16px;
    }
    .work-thumb {
      width: 88px;
      height: 88px;
    }
    .filter {
      min-height: 44px;
    }
  }
</style>
