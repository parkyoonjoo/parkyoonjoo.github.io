---
import Detail from '../layouts/Detail.astro';
import data from '../../content/publications.json';
import { u } from '../lib/url';

// content/publications.json: { "papers": [...], "posters": [...] }
// 항목 형식: { "title", "authors", "venue", "year", "month"?, "location"?, "url"?, "venueUrl"?, "pdf"? }
// - url: 논문 페이지 링크 (선택, 제목에 걸림)
// - venueUrl: 학회 홈페이지 (선택, 학회 이름에 걸림)
// - pdf: 포스터·논문 파일 (public 폴더 기준 경로, 선택)
// - thumb: 옆에 보이는 작은 미리보기 이미지 (선택). 누르면 pdf(없으면 url)가 열림
type Pub = {
  title: string;
  authors: string;
  venue: string;
  year: number | string;
  month?: string;
  location?: string;
  url?: string;
  venueUrl?: string;
  pdf?: string;
  thumb?: string;
};

const byYear = (list: Pub[]) => list.slice().sort((a, b) => String(b.year).localeCompare(String(a.year)));

const groups = [
  { key: 'papers', heading: 'Papers', items: byYear((data.papers ?? []) as Pub[]) },
  { key: 'posters', heading: 'Poster Presentations', items: byYear((data.posters ?? []) as Pub[]) },
];

// 저자 목록에서 본인 이름을 굵게
// ("Park, Y." 형식은 넣지 않음: "Kyuwon Park, Youree"처럼 다른 사람 이름에 잘못 걸린다)
const ME = /(Yoonjoo Park|Y\.\s?Park|박윤주)/;
const splitAuthors = (s: string) => s.split(ME).map((part, i) => ({ text: part, me: i % 2 === 1 }));
---

<Detail title="Publications" section="publications" description="Papers and poster presentations by Yoonjoo Park.">
  <h1 class="page-title">Publications</h1>

  {
    groups.map((g) => (
      <section class="group" aria-labelledby={`h-${g.key}`}>
        <h2 class="group-h" id={`h-${g.key}`}>
          {g.heading}
        </h2>
        {g.items.length === 0 ? (
          <p class="empty muted">In preparation.</p>
        ) : (
          <ol class="pubs">
            {g.items.map((p) => (
              <li class:list={[{ 'has-thumb': p.thumb }]}>
                {p.thumb && (
                  <a class="pub-thumb" href={p.pdf ? u(p.pdf) : p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                    <img src={u(p.thumb)} alt="" width="637" height="900" loading="lazy" decoding="async" />
                  </a>
                )}
                <div class="pub-text">
                <p class="pub-title">
                  {p.url ? (
                    <a class="text-link" href={p.url} target="_blank" rel="noopener">
                      {p.title}
                    </a>
                  ) : (
                    p.title
                  )}
                </p>
                <p class="pub-authors">
                  {splitAuthors(p.authors).map((a) => (a.me ? <strong>{a.text}</strong> : a.text))}
                </p>
                <p class="pub-meta muted">
                  {p.venueUrl ? (
                    <a class="venue-link" href={p.venueUrl} target="_blank" rel="noopener">
                      {p.venue}
                    </a>
                  ) : (
                    p.venue
                  )}
                  {[p.location, [p.month, p.year].filter(Boolean).join(' ')].filter(Boolean).map((x) => ` · ${x}`)}
                </p>
                {p.pdf && (
                  <p class="pub-links">
                    <a class="text-link" href={u(p.pdf)} target="_blank" rel="noopener">
                      {g.key === 'posters' ? 'Poster (PDF)' : 'Paper (PDF)'}
                    </a>
                  </p>
                )}
                </div>
              </li>
            ))}
          </ol>
        )}
      </section>
    ))
  }
</Detail>

<style>
  .group + .group {
    margin-top: 56px;
  }

  .group-h {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--fg-muted);
  }

  .empty {
    font-size: 15px;
    margin: 12px 0 0;
  }

  .group:last-of-type {
    margin-bottom: 24vh;
  }

  .pubs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pubs li {
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .pubs li.has-thumb {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 24px;
    align-items: start;
  }

  .pub-thumb {
    display: block;
    overflow: hidden;
    background: #111;
  }

  .pub-thumb img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 300ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .pub-thumb:hover img {
      transform: scale(1.03);
    }
  }

  @media (max-width: 640px) {
    .pubs li.has-thumb {
      grid-template-columns: 72px 1fr;
      gap: 16px;
    }
  }

  .pub-title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }

  .pub-authors {
    margin: 0 0 4px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .pub-authors strong {
    color: #fff;
    font-weight: 700;
  }

  .pub-meta {
    margin: 0;
    font-size: 13px;
  }

  .venue-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 3px;
  }

  .venue-link:hover {
    color: #fff;
  }

  .pub-links {
    margin: 8px 0 0;
    font-size: 13px;
  }
</style>
