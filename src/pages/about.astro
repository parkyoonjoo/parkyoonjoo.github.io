---
import Detail from '../layouts/Detail.astro';
import about from '../../content/about.json';
import { u, isTodo } from '../lib/url';

---

<Detail title="Yoonjoo" section="about" description="Yoonjoo Park: education, research interests and experience, skills, CV and contact.">
  <div class="about">
    <img class="about-photo" src={u(about.photo)} alt={about.photoAlt} width="1600" height="1200" />

    <div class="about-body">
      <h1 class="about-name">{about.name}</h1>

      <section class="about-block">
        <h2 class="about-h">Education</h2>
        <ul class="entries">
          {
            about.education.map((e) => (
              <li>
                <span class="entry-period muted">{e.period}</span>
                <span class="entry-main">{e.school}</span>
                <span class="entry-detail muted">{e.detail}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about-block">
        <h2 class="about-h">Research Interests</h2>
        <ul class="plain">
          {about.interests.map((i) => <li>{i}</li>)}
        </ul>
      </section>

      <section class="about-block">
        <h2 class="about-h">Research Experience</h2>
        <ul class="entries">
          {
            about.experience.map((e) => (
              <li>
                <span class="entry-period muted">{e.period}</span>
                <span class="entry-main">{e.place}</span>
                <span class="entry-detail muted">{e.detail}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about-block">
        <h2 class="about-h">Skills</h2>
        <dl class="skills">
          {
            about.skills.map((g) => (
              <div>
                <dt class="muted">{g.label}</dt>
                <dd>{g.items}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="about-block">
        <h2 class="about-h">CV</h2>
        <p><a class="text-link" href={u(about.cv)} target="_blank" rel="noopener">Download CV (PDF)</a></p>
      </section>

      <section class="about-block">
        <h2 class="about-h">Contact</h2>
        <ul class="contact">
          {
            about.contact.emails.map((m) => (
              <li>
                <a class="text-link" href={`mailto:${m}`}>
                  {m}
                </a>
              </li>
            ))
          }
          {
            (about.contact.links as { label: string; url: string }[])
              .filter((l) => l.url && !isTodo(l.url))
              .map((l) => (
                <li>
                  <a class="text-link" href={l.url} target="_blank" rel="noopener">
                    {l.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </section>
    </div>
  </div>
</Detail>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .about-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .about-name {
    margin: 0 0 44px;
    font-size: clamp(36px, 4.6vw, 64px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .about-block {
    margin-bottom: 32px;
  }

  .about-h {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 700;
    color: var(--fg-muted);
  }

  .about-block p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }

  .entries,
  .plain,
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
    line-height: 1.6;
  }

  .entries li + li {
    margin-top: 14px;
  }

  .entries li {
    display: flex;
    flex-direction: column;
  }

  .entry-period {
    font-size: 12px;
    line-height: 1.5;
  }

  .entry-main {
    font-weight: 700;
  }

  .entry-detail {
    font-size: 14px;
  }

  .skills {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }

  .skills div + div {
    margin-top: 8px;
  }

  .skills dt {
    font-size: 12px;
  }

  .skills dd {
    margin: 0;
  }

  .contact li + li {
    margin-top: 4px;
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
    /* 휴대폰: 사진을 화면 폭 가득 가로로, 그 밑에 소개 */
    .about-photo {
      width: 100%;
    }
  }
</style>
